{
  "$about": "runway design tokens, proposal 03 'Papier & Tinte'. One source for web (CSS custom properties) and Android (Kotlin). Brand values are copied from the Agentic Reach kit and never edited here; semantic colours only reference brand colours or mix them (color-mix in srgb). Generate with: node tokens/gen-tokens.mjs",
  "brand": {
    "coral": "#FF7A6B",
    "plum": "#3D2B5C",
    "yellow": "#F4C84A",
    "ink": "#1B1428",
    "bg": "#FBF6EE",
    "bgAlt": "#F4ECE0",
    "bgCool": "#F1EEF4",
    "paper": "#FFFFFF"
  },
  "color": {
    "light": {
      "bg":          "bg",
      "surface":     "paper",
      "sunk":        "bgAlt",
      "cool":        "bgCool",
      "text":        "ink",
      "mute":        { "mix": ["ink", 62, "transparent"] },
      "soft":        { "mix": ["ink", 40, "transparent"] },
      "rule":        { "mix": ["ink", 10, "transparent"] },
      "ruleStrong":  { "mix": ["ink", 20, "transparent"] },
      "hover":       { "mix": ["ink", 4, "transparent"] },
      "focus":       { "mix": ["plum", 12, "transparent"] },
      "select":      { "mix": ["plum", 18, "transparent"] },
      "accent":      "plum",
      "action":      "coral",
      "onAction":    "ink",
      "marker":      "yellow",
      "overdue":     { "mix": ["coral", 60, "ink"] },
      "overdueMark": "coral",
      "inverse":     "ink",
      "onInverse":   "bg",
      "inverseAction": "coral",
      "inkA":        "coral",
      "inkB":        "plum",
      "scrim":       { "mix": ["ink", 40, "transparent"] }
    },
    "dark": {
      "bg":          "ink",
      "surface":     { "mix": ["bg", 7, "ink"] },
      "sunk":        { "mix": ["bg", 4, "ink"] },
      "cool":        { "mix": ["plum", 35, "ink"] },
      "text":        "bg",
      "mute":        { "mix": ["bg", 70, "transparent"] },
      "soft":        { "mix": ["bg", 50, "transparent"] },
      "rule":        { "mix": ["bg", 12, "transparent"] },
      "ruleStrong":  { "mix": ["bg", 22, "transparent"] },
      "hover":       { "mix": ["bg", 5, "transparent"] },
      "focus":       { "mix": [{ "mix": ["plum", 45, "bg"] }, 16, "transparent"] },
      "select":      { "mix": [{ "mix": ["plum", 45, "bg"] }, 34, "transparent"] },
      "accent":      { "mix": ["plum", 45, "bg"] },
      "action":      "coral",
      "onAction":    "ink",
      "marker":      "yellow",
      "overdue":     "coral",
      "overdueMark": "coral",
      "inverse":     "bg",
      "onInverse":   "ink",
      "inverseAction": { "mix": ["coral", 60, "ink"] },
      "inkA":        "coral",
      "inkB":        { "mix": ["plum", 45, "bg"] },
      "scrim":       { "mix": ["ink", 70, "transparent"] }
    }
  },
  "font": {
    "sans": "Space Grotesk",
    "serif": "Fraunces",
    "mono": "JetBrains Mono"
  },
  "type": {
    "display": { "font": "sans",  "weight": 500, "web": "clamp(34px, 3.6vw, 54px)", "android": 32, "line": 1.04, "tracking": -0.03 },
    "title":   { "font": "sans",  "weight": 500, "web": "24px",   "android": 22, "line": 1.2,  "tracking": -0.015 },
    "row":     { "font": "sans",  "weight": 400, "web": "15px",   "android": 16, "line": 1.4,  "tracking": -0.005 },
    "body":    { "font": "sans",  "weight": 400, "web": "14px",   "android": 15, "line": 1.55, "tracking": 0 },
    "meta":    { "font": "mono",  "weight": 400, "web": "11.5px", "android": 12, "line": 1.35, "tracking": 0.02 },
    "eyebrow": { "font": "mono",  "weight": 400, "web": "11px",   "android": 11, "line": 1.3,  "tracking": 0.06 },
    "accent":  { "font": "serif", "weight": 300, "italic": true }
  },
  "radius": { "sm": 8, "md": 12, "lg": 18, "xl": 22, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },
  "size": { "rowWeb": 40, "rowAndroid": 56, "touch": 48, "ringWeb": 18, "ringAndroid": 22, "rail": 232, "margin": 392 },
  "motion": {
    "ease": [0.2, 0.8, 0.2, 1],
    "fast": 120,
    "base": 180,
    "slow": 260,
    "strike": 260,
    "strikeHold": 380,
    "collapse": 180,
    "undo": 6000,
    "bloom": 2400,
    "settle": 800
  }
}
