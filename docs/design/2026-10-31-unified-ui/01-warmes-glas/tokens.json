{
  "$description": "runway design tokens, proposal 01 Warmes Glas. One source for both clients: a generator writes tokens.css (CSS variables), tailwind.preset.js (theme.extend) and RunwayTokens.kt (Compose). Brand values come from the Agentic Reach kit (brand/tokens.css). Mixed colours are stored as the formula plus the computed hex, because Compose cannot evaluate color-mix().",
  "brand": {
    "coral": { "$type": "color", "$value": "#FF7A6B" },
    "plum": { "$type": "color", "$value": "#3D2B5C" },
    "yellow": { "$type": "color", "$value": "#F4C84A" },
    "ink": { "$type": "color", "$value": "#1B1428" },
    "bg": { "$type": "color", "$value": "#FBF6EE" },
    "bgAlt": { "$type": "color", "$value": "#F4ECE0" },
    "bgCool": { "$type": "color", "$value": "#F1EEF4" },
    "paper": { "$type": "color", "$value": "#FFFFFF" }
  },
  "color": {
    "light": {
      "ground": { "$type": "color", "$value": "{brand.bg}", "$description": "page and header background; the lens scene background" },
      "groundSunk": { "$type": "color", "$value": "{brand.bgAlt}", "$description": "sidebar, Android navigation bar" },
      "surface": { "$type": "color", "$value": "{brand.paper}", "$description": "cards: paper on warm ground" },
      "surfaceTint": { "$type": "color", "$value": "{brand.bgCool}", "$description": "selected row, hover" },
      "text": { "$type": "color", "$value": "{brand.ink}" },
      "textMute": { "$type": "color", "$value": "#726D7A", "$extensions": { "mix": "ink 62% over paper" } },
      "line": { "$type": "color", "$value": "#1B14281A", "$extensions": { "mix": "ink 10% alpha" } },
      "action": { "$type": "color", "$value": "{brand.coral}", "$description": "primary action, check-off, the lens, the bead, overdue ring" },
      "onAction": { "$type": "color", "$value": "{brand.ink}", "$description": "text on coral (7.0:1); paper on coral is 2.6:1" },
      "actionInk": { "$type": "color", "$value": "#A85352", "$extensions": { "mix": "coral 62% + ink" }, "$description": "small coral text: überfällig, läuft, Rückgängig on light (5.2:1)" },
      "actionTint": { "$type": "color", "$value": "#FFEFED", "$extensions": { "mix": "coral 12% over paper" }, "$description": "only the swipe-to-check-off reveal" },
      "structure": { "$type": "color", "$value": "{brand.plum}", "$description": "selected navigation, project names, focus ring, switches, step numbers, Fraunces accent" },
      "structureSelect": { "$type": "color", "$value": "#3D2B5C1C", "$extensions": { "mix": "plum 11% alpha" }, "$description": "selected navigation item and tab indicator (not coral)" },
      "attention": { "$type": "color", "$value": "{brand.yellow}", "$description": "dot, ring or 1px line only: stalled project, follow-up due, undo window" },
      "inverse": { "$type": "color", "$value": "{brand.ink}" },
      "onInverse": { "$type": "color", "$value": "{brand.bg}" }
    },
    "dark": {
      "ground": { "$type": "color", "$value": "{brand.ink}" },
      "groundSunk": { "$type": "color", "$value": "#1E162D", "$extensions": { "mix": "ink 90% + plum" } },
      "surface": { "$type": "color", "$value": "#241A36", "$extensions": { "mix": "ink 74% + plum" } },
      "surfaceTint": { "$type": "color", "$value": "#291D3D", "$extensions": { "mix": "ink 60% + plum" } },
      "text": { "$type": "color", "$value": "{brand.bg}" },
      "textMute": { "$type": "color", "$value": "#BBB4B7", "$extensions": { "mix": "bg 70% over surface" } },
      "line": { "$type": "color", "$value": "#FBF6EE1F", "$extensions": { "mix": "bg 12% alpha" } },
      "action": { "$type": "color", "$value": "{brand.coral}" },
      "onAction": { "$type": "color", "$value": "{brand.ink}" },
      "actionInk": { "$type": "color", "$value": "#FE9385", "$extensions": { "mix": "coral 80% + bg" } },
      "actionTint": { "$type": "color", "$value": "#3A2238", "$extensions": { "mix": "coral 14% over surface" } },
      "structure": { "$type": "color", "$value": "#A69BAC", "$extensions": { "mix": "plum 45% + bg" }, "$description": "plum on ink is unreadable (1.6:1); this is 6.7:1" },
      "structureSelect": { "$type": "color", "$value": "#FBF6EE1C", "$extensions": { "mix": "bg 11% alpha" } },
      "attention": { "$type": "color", "$value": "{brand.yellow}" },
      "inverse": { "$type": "color", "$value": "{brand.bg}" },
      "onInverse": { "$type": "color", "$value": "{brand.ink}" }
    }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Space Grotesk", "system-ui", "sans-serif"], "$extensions": { "weights": [400, 500] } },
    "serif": { "$type": "fontFamily", "$value": ["Fraunces", "Georgia", "serif"], "$extensions": { "weights": [300], "style": "italic", "use": "one accent word per view" } },
    "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$extensions": { "weights": [400], "note": "the kit allows 400/500; runway uses 400 only (500 is not in the shipped font set)" } }
  },
  "type": {
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontWeight": 500, "fontSize": "34px", "lineHeight": 1.05, "letterSpacing": "-0.025em" }, "$extensions": { "android": "28.sp headlineMedium" } },
    "title": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontWeight": 500, "fontSize": "20px", "lineHeight": 1.25, "letterSpacing": "-0.015em" }, "$extensions": { "android": "22.sp titleLarge" } },
    "lede": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.45 } },
    "row": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontWeight": 400, "fontSize": "15px", "lineHeight": 1.4 }, "$extensions": { "android": "16.sp bodyLarge" } },
    "meta": { "$type": "typography", "$value": { "fontFamily": "{font.sans}", "fontWeight": 400, "fontSize": "12.5px", "lineHeight": 1.35 }, "$extensions": { "android": "13.sp bodySmall" } },
    "section": { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "12.5px", "lineHeight": 1, "letterSpacing": "0.01em" }, "$description": "section headings (// Fällig 1), written mixed case on both clients: Compose cannot uppercase, and Android's P08 driver looks for the literal string Fällig", "$extensions": { "android": "13.sp" } },
    "label": { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "11px", "lineHeight": 1.3, "letterSpacing": "0.08em", "textTransform": "uppercase" }, "$extensions": { "android": "11.sp labelSmall" } },
    "number": { "$type": "typography", "$value": { "fontFamily": "{font.mono}", "fontWeight": 400, "fontSize": "12px", "lineHeight": 1, "fontFeature": "tnum" } }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "18px", "$description": "cards" },
    "xl": { "$type": "dimension", "$value": "22px", "$description": "panels, sheets, palette" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "buttons, chips, capture field" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px" },
  "size": {
    "touch": { "$type": "dimension", "$value": "48px" },
    "row": { "$type": "dimension", "$value": "56px" },
    "ring": { "$type": "dimension", "$value": "20px", "$extensions": { "android": "24.dp in a 48.dp target" } },
    "lens": { "$type": "dimension", "$value": "120px", "$extensions": { "android": "44.dp in the top bar" } },
    "lensCompact": { "$type": "dimension", "$value": "44px" },
    "bead": { "$type": "dimension", "$value": "12px" }
  },
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms", "$description": "press, hover, ring fill" },
      "base": { "$type": "duration", "$value": "180ms", "$description": "chips, toggles, row collapse" },
      "slow": { "$type": "duration", "$value": "260ms", "$description": "panels, sheets" },
      "flight": { "$type": "duration", "$value": "620ms", "$description": "bead from row to lens" },
      "settle": { "$type": "duration", "$value": "600ms", "$description": "liquid wobble decays" },
      "undo": { "$type": "duration", "$value": "6000ms", "$description": "hold before a write is sent; same on both clients" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1], "$description": "brand --ar-ease; everything that settles" },
      "pull": { "$type": "cubicBezier", "$value": [0.55, 0, 0.25, 1], "$description": "bead: starts slow, is pulled into the lens" },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    },
    "spring": {
      "level": { "$type": "spring", "$value": { "dampingRatio": 0.62, "stiffness": 180 }, "$description": "liquid level rise, one small overshoot" },
      "wobble": { "$type": "spring", "$value": { "dampingRatio": 0.4, "stiffness": 260 }, "$description": "surface tilt after a bead lands: one visible swing, settled in about 0.6 s; the only impact effect" }
    }
  }
}
