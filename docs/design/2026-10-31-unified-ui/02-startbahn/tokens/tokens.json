{
  "$comment": "Startbahn: one token source for web and Android. Brand values come from shared/brand/tokens.css; every semantic colour is a mix or alpha of a brand colour. gen-tokens.mjs writes tokens.css (CSS variables) and RunwayTokens.kt (Compose).",
  "brand": {
    "coral": "#FF7A6B",
    "plum": "#3D2B5C",
    "yellow": "#F4C84A",
    "ink": "#1B1428",
    "bg": "#FBF6EE",
    "bgAlt": "#F4ECE0",
    "bgCool": "#F1EEF4",
    "paper": "#FFFFFF"
  },
  "color": {
    "surface":         { "light": "bg",                     "dark": "ink" },
    "surface-sunken":  { "light": "bgAlt",                  "dark": ["mix", "bg", 4, "ink"] },
    "surface-raised":  { "light": "paper",                  "dark": ["mix", "bg", 8, "ink"] },
    "surface-hover":   { "light": ["mix", "ink", 4, "bg"],  "dark": ["mix", "bg", 11, "ink"] },
    "surface-inverse": { "light": "ink",                    "dark": "bg" },
    "text":            { "light": "ink",                    "dark": "bg" },
    "text-mute":       { "light": ["alpha", "ink", 66],     "dark": ["alpha", "bg", 72] },
    "text-soft":       { "light": ["alpha", "ink", 48],     "dark": ["alpha", "bg", 52] },
    "text-inverse":    { "light": "bg",                     "dark": "ink" },
    "line":            { "light": ["alpha", "ink", 10],     "dark": ["alpha", "bg", 12] },
    "line-strong":     { "light": ["alpha", "ink", 20],     "dark": ["alpha", "bg", 24] },
    "action":          { "light": "coral",                  "dark": "coral" },
    "on-action":       { "light": "ink",                    "dark": "ink" },
    "action-hover":    { "light": ["mix", "ink", 8, "coral"], "dark": ["mix", "bg", 14, "coral"] },
    "action-on-inverse": { "light": "coral",                "dark": ["mix", "coral", 62, "ink"] },
    "now":             { "light": "coral",                  "dark": "coral" },
    "now-text":        { "light": ["mix", "coral", 62, "ink"], "dark": "coral" },
    "now-tint":        { "light": ["alpha", "coral", 12],   "dark": ["alpha", "coral", 16] },
    "progress":        { "light": "yellow",                 "dark": "yellow" },
    "wait":            { "light": "plum",                   "dark": ["mix", "plum", 45, "bg"] },
    "wait-tint":       { "light": ["alpha", "plum", 8],     "dark": ["alpha", "bg", 8] },
    "emphasis":        { "light": "plum",                   "dark": ["mix", "plum", 40, "bg"] },
    "selected":        { "light": ["alpha", "ink", 6],      "dark": ["alpha", "bg", 9] },
    "focus":           { "light": ["alpha", "coral", 45],   "dark": ["alpha", "coral", 55] },
    "scrim":           { "light": ["alpha", "ink", 45],     "dark": ["alpha", "ink", 70] },
    "field-sky":       { "light": "bgCool",                 "dark": ["mix", "plum", 30, "ink"] },
    "field-ground":    { "light": "bgAlt",                  "dark": ["mix", "bg", 6, "ink"] },
    "field-strip":     { "light": ["mix", "ink", 17, "bgAlt"], "dark": ["mix", "bg", 13, "ink"] },
    "field-marking":   { "light": "paper",                  "dark": ["mix", "bg", 48, "ink"] }
  },
  "radius": { "sm": 8, "md": 12, "lg": 18, "xl": 22, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "type": {
    "display":  { "family": "sans",  "weight": 500, "size": 34, "line": 38, "tracking": -0.03 },
    "title":    { "family": "sans",  "weight": 500, "size": 19, "line": 25, "tracking": -0.015 },
    "body":     { "family": "sans",  "weight": 400, "size": 15, "line": 22, "tracking": 0 },
    "body-strong": { "family": "sans", "weight": 500, "size": 15, "line": 22, "tracking": 0 },
    "meta":     { "family": "sans",  "weight": 400, "size": 13, "line": 18, "tracking": 0 },
    "eyebrow":  { "family": "mono",  "weight": 400, "size": 11, "line": 14, "tracking": 0.08, "case": "upper" },
    "numeral":  { "family": "mono",  "weight": 400, "size": 12, "line": 16, "tracking": 0.02 },
    "accent":   { "family": "serif", "weight": 300, "size": 19, "line": 25, "tracking": -0.01, "style": "italic" }
  },
  "motion": {
    "ease":        [0.2, 0.8, 0.2, 1],
    "ease-taxi":   [0.45, 0, 0.2, 1],
    "ease-roll":   [0.55, 0, 0.9, 0.35],
    "fast": 120,
    "base": 180,
    "slow": 260,
    "taxi": 480,
    "camera": 720,
    "liftoff": 1100,
    "undo-window": 6000
  }
}
