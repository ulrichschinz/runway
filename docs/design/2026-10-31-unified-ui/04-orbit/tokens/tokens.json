    "fast": 120,
    "base": 180,
    "slow": 260,
    "camera": 700,
    "complete": 900,
    "flight": 1100,
    "undoHold": 6000
  },
  "orbit": {
    "$comment": "World units shared by the Three.js scene, the SVG fallback and the Android canvas.",
