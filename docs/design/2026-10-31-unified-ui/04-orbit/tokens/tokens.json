  "type": {
    "display":  { "family": "sans",  "weight": 500, "size": 30, "line": 34, "tracking": -0.03 },
    "title":    { "family": "sans",  "weight": 500, "size": 18, "line": 24, "tracking": -0.02 },
    "body":     { "family": "sans",  "weight": 400, "size": 15, "line": 21, "tracking": -0.005 },
    "bodyStrong": { "family": "sans", "weight": 500, "size": 15, "line": 21, "tracking": -0.005 },
    "small":    { "family": "sans",  "weight": 400, "size": 13, "line": 18, "tracking": 0 },
    "meta":     { "family": "mono",  "weight": 400, "size": 11.5, "line": 16, "tracking": 0.02 },
    "eyebrow":  { "family": "mono",  "weight": 400, "size": 11, "line": 14, "tracking": 0.08, "upper": true },
    "accent":   { "family": "serif", "weight": 300, "size": 18, "line": 24, "tracking": -0.01, "italic": true }
  },
  "shape": { "sm": 8, "md": 12, "lg": 18, "xl": 22, "pill": 999, "touch": 48, "row": 56 },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)",
