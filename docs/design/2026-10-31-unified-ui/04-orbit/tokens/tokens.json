{
  "$comment": "Orbit: one token source for web (CSS variables) and Android (Compose theme). Colours are brand colours or color-mix() derivations of them, never new hex values. Generate with: node tokens/gen-tokens.mjs",
  "brand": {
    "coral": "#FF7A6B",
    "plum": "#3D2B5C",
    "yellow": "#F4C84A",
    "ink": "#1B1428",
    "bg": "#FBF6EE",
    "bgAlt": "#F4ECE0",
    "bgCool": "#F1EEF4",
    "paper": "#FFFFFF"
  },
  "color": {
    "light": {
      "canvas":        "bg",
      "sunken":        "bgAlt",
      "surface":       "paper",
      "raised":        "paper",
      "space":         "bgCool",
      "text":          "ink",
      "textMute":      "alpha(ink 62%)",
      "textSoft":      "alpha(ink 42%)",
      "line":          "alpha(ink 10%)",
      "lineStrong":    "alpha(ink 18%)",
      "hover":         "alpha(plum 4%)",
      "selected":      "alpha(plum 8%)",
      "action":        "coral",
      "onAction":      "ink",
      "focus":         "plum",
      "accentText":    "plum",
      "live":          "coral",
      "attention":     "yellow",
      "overdueBar":    "coral",
      "overdueText":   "mix(coral 62%, ink)",
      "inverse":       "ink",
      "onInverse":     "bg",
      "inverseAccent": "mix(plum 30%, bg)",
      "scrim":         "alpha(ink 38%)",
      "disc":          "paper",
      "discSelected":  "paper",
      "discDim":       "mix(plum 16%, bgCool)",
      "hub":           "bgAlt",
      "ringLine":      "plum",
      "beadNext":      "plum",
      "beadWaiting":   "mix(plum 55%, bgCool)",
      "beadInbox":     "mix(ink 44%, bgAlt)",
      "beadDim":       "mix(plum 14%, bg)"
    },
    "dark": {
      "canvas":        "mix(ink 90%, plum)",
      "sunken":        "ink",
      "surface":       "mix(ink 80%, plum)",
      "raised":        "mix(ink 68%, plum)",
      "space":         "mix(ink 86%, plum)",
      "text":          "bg",
      "textMute":      "alpha(bg 70%)",
      "textSoft":      "alpha(bg 50%)",
      "line":          "alpha(bg 12%)",
      "lineStrong":    "alpha(bg 20%)",
      "hover":         "alpha(bg 5%)",
      "selected":      "alpha(plum 60%)",
      "action":        "coral",
      "onAction":      "ink",
      "focus":         "mix(plum 45%, bg)",
      "accentText":    "mix(plum 35%, bg)",
      "live":          "coral",
      "attention":     "yellow",
      "overdueBar":    "coral",
      "overdueText":   "coral",
      "inverse":       "bg",
      "onInverse":     "ink",
      "inverseAccent": "plum",
      "scrim":         "alpha(ink 62%)",
      "disc":          "mix(ink 62%, plum)",
      "discSelected":  "mix(plum 82%, bg)",
      "discDim":       "mix(ink 78%, plum)",
      "hub":           "mix(ink 50%, plum)",
      "ringLine":      "mix(plum 45%, bg)",
      "beadNext":      "mix(plum 40%, bg)",
      "beadWaiting":   "mix(plum 55%, bg)",
      "beadInbox":     "mix(bg 55%, plum)",
      "beadDim":       "mix(plum 50%, ink)"
