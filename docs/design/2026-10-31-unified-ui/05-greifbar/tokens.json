    "coral": "#FF7A6B",
    "plum": "#3D2B5C",
    "yellow": "#F4C84A",
    "ink": "#1B1428",
    "bg": "#FBF6EE",
    "bgAlt": "#F4ECE0",
    "bgCool": "#F1EEF4",
    "paper": "#FFFFFF"
  },
