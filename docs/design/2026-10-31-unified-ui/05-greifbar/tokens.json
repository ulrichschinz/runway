    "$comment": "pillLine: the check pill's outline, 3.4:1 on paper and 3.5:1 on the dark sheet (WCAG 1.4.11). done/onDone: the checked pill (plum, not coral: coral stays the call to action). The overdue pill outline uses urgentText."
  },
  "font": {
    "sans": "Space Grotesk",
    "serif": "Fraunces",
    "mono": "JetBrains Mono"
  },
  "type": {
    "display": {
      "font": "sans",
      "size": 40,
      "line": 1.04,
      "weight": 500,
      "tracking": -0.03
    },
    "title": {
      "font": "sans",
      "size": 26,
      "line": 1.18,
      "weight": 500,
      "tracking": -0.02
    },
    "cardText": {
      "font": "sans",
      "size": 24,
      "line": 1.22,
      "weight": 500,
      "tracking": -0.015
    },
    "row": {
      "font": "sans",
      "size": 15,
      "line": 1.35,
      "weight": 500,
      "tracking": -0.005
    },
    "body": {
      "font": "sans",
      "size": 14,
      "line": 1.5,
      "weight": 400,
      "tracking": 0
    },
    "label": {
      "font": "sans",
      "size": 13,
      "line": 1.3,
      "weight": 500,
      "tracking": 0
    },
    "meta": {
      "font": "mono",
      "size": 12,
      "line": 1.35,
      "weight": 400,
      "tracking": 0.02
    },
    "eyebrow": {
      "font": "mono",
      "size": 11,
      "line": 1.2,
      "weight": 400,
      "tracking": 0.08,
      "case": "upper"
    },
    "accent": {
      "font": "serif",
      "size": "inherit",
      "weight": 300,
      "style": "italic",
      "color": "accent"
    }
  },
  "androidType": {
    "$comment": "sp on Android; same roles, row is 16 sp for touch reading distance",
    "row": 16,
    "meta": 12,
    "title": 22,
    "display": 32,
    "cardText": 22
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 18,
    "xl": 22,
    "pill": 999,
    "card": "xl",
    "sheet": "lg",
    "tray": "lg",
    "field": "pill",
    "chip": "pill",
    "check": "pill"
  },
  "size": {
    "checkPill": {
      "w": 30,
      "h": 20,
      "hit": 44,
      "stroke": 1.5
    },
    "androidCheckPill": {
      "w": 32,
      "h": 22,
      "hit": 48
    },
    "row": {
      "web": 52,
      "android": 56
    },
    "stackCard": {
      "w": 520,
      "h": 296,
      "phoneW": "100% - 40",
      "phoneH": 248
    },
    "companion": {
      "web": 64,
      "phone": 44,
      "android": 40,
      "$comment": "web: sidebar foot; phone web and Android: the Klären screen only (the top bars show the static mark)"
    }
  },
  "elevation": {
    "$comment": "brand shadows only",
    "sheet": "--ar-shadow-sm",
    "dock": "--ar-shadow-md",
    "card": "--ar-shadow-lg",
    "overlay": "--ar-shadow-xl"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "fast": 120,
    "base": 180,
    "slow": 260,
    "spring": {
      "follow": {
        "stiffness": 900,
        "damping": 60,
        "use": "card under the finger"
      },
      "settle": {
        "stiffness": 260,
        "damping": 22,
        "use": "card back to the stack, next card rising"
      },
      "tilt": {
        "stiffness": 320,
        "damping": 24,
        "use": "card rotation from drag velocity"
      },
      "squish": {
        "stiffness": 520,
        "damping": 11,
        "use": "check pill press and rebound"
      },
      "tray": {
        "css": "linear(0, 0.35 8%, 1.12 30%, 0.97 50%, 1.01 70%, 1)",
        "duration": 420,
        "use": "tray accepts a card"
      },
      "hold": {
        "stiffness": 300,
        "damping": 24,
        "use": "card held on the stack while a step asks (lift 24, top 0.06 rad towards you)"
      }
    },
    "flight": {
      "min": 260,
      "max": 460,
      "use": "card from release point into a tray"
    },
    "undoWindow": 6000,
    "rowLeave": 900
  },
  "compose": {
    "$comment": "Compose spring equivalents: dampingRatio = damping / (2*sqrt(stiffness)), stiffness unchanged",
    "follow": {
      "dampingRatio": 1.0,
      "stiffness": 900
    },
    "settle": {
      "dampingRatio": 0.68,
      "stiffness": 260
    },
    "tilt": {
      "dampingRatio": 0.67,
      "stiffness": 320
    },
    "squish": {
      "dampingRatio": 0.24,
      "stiffness": 520
    },
    "hold": {
      "dampingRatio": 0.69,
      "stiffness": 300
    }
  },
  "gl": {
    "$comment": "3D material colours (gl.js, Android AGSL uniforms); mixes resolved the same way",
    "light": {
      "pillRest": {
        "ref": "paper"
      },
      "pillDone": {
        "ref": "plum"
      },
      "check": {
        "ref": "bg"
      },
      "companionClay": {
        "ref": "plum"
      },
      "companionLit": {
        "ref": "paper"
      },
      "contactShadow": {
        "mix": [
          "ink",
          12,
          "transparent"
        ]
      }
    },
    "dark": {
      "pillRest": {
        "mix": [
          "bg",
          6,
          "ink"
        ]
      },
      "pillDone": {
        "mix": [
          "plum",
          28,
          "bg"
        ]
      },
      "check": {
        "ref": "ink"
      },
      "companionClay": {
        "mix": [
          "plum",
          62,
          "bg"
        ]
      },
      "companionLit": {
        "ref": "bg"
      },
      "contactShadow": {
        "mix": [
          "ink",
          45,
          "transparent"
        ]
      }
    }
  }
}