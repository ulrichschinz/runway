    "light": {
      "bg": {
        "ref": "bg"
      },
      "side": {
        "mix": [
          "bgAlt",
          55,
          "bg"
        ]
      },
      "sheet": {
        "ref": "paper"
      },
      "tray": {
        "ref": "bgAlt"
      },
      "sunk": {
        "mix": [
          "ink",
          4,
          "bg"
        ]
      },
      "text": {
        "ref": "ink"
      },
      "mute": {
        "mix": [
          "ink",
          62,
          "transparent"
        ]
      },
      "soft": {
        "mix": [
          "ink",
          40,
          "transparent"
        ]
      },
      "line": {
        "mix": [
          "ink",
          10,
          "transparent"
        ]
      },
      "lineStrong": {
        "mix": [
          "ink",
          18,
          "transparent"
        ]
      },
      "pillLine": {
        "mix": [
          "ink",
          50,
          "transparent"
        ]
      },
      "accent": {
        "ref": "plum"
      },
      "accentTint": {
        "mix": [
          "plum",
          8,
          "transparent"
        ]
      },
      "action": {
        "ref": "coral"
      },
      "onAction": {
        "ref": "ink"
      },
      "actionTint": {
        "mix": [
          "coral",
          14,
          "transparent"
        ]
      },
      "urgentText": {
        "mix": [
          "coral",
          65,
          "ink"
        ]
      },
      "attention": {
        "ref": "yellow"
      },
      "done": {
        "ref": "plum"
      },
      "onDone": {
        "ref": "bg"
      },
      "inverse": {
        "ref": "ink"
      },
      "onInverse": {
        "ref": "bg"
      },
      "chipOn": {
        "ref": "plum"
      },
      "onChipOn": {
        "ref": "bg"
      },
      "scrim": {
        "mix": [
          "ink",
          40,
          "transparent"
        ]
      }
    },
    "dark": {
      "bg": {
        "ref": "ink"
      },
      "side": {
        "mix": [
          "bg",
          3,
          "ink"
        ]
      },
      "sheet": {
        "mix": [
          "bg",
          6,
          "ink"
        ]
      },
      "tray": {
        "mix": [
          "plum",
          34,
          "ink"
        ]
      },
      "sunk": {
        "mix": [
          "bg",
          3,
          "ink"
        ]
      },
      "text": {
        "ref": "bg"
      },
      "mute": {
        "mix": [
          "bg",
          70,
          "transparent"
        ]
      },
      "soft": {
        "mix": [
          "bg",
          50,
          "transparent"
        ]
      },
      "line": {
        "mix": [
          "bg",
          12,
          "transparent"
        ]
      },
      "lineStrong": {
        "mix": [
          "bg",
          22,
          "transparent"
        ]
      },
      "pillLine": {
        "mix": [
          "bg",
          40,
          "transparent"
        ]
      },
      "accent": {
        "mix": [
          "plum",
          28,
          "bg"
        ]
      },
      "accentTint": {
        "mix": [
          "plum",
          48,
          "transparent"
        ]
      },
      "action": {
        "ref": "coral"
      },
      "onAction": {
        "ref": "ink"
      },
      "actionTint": {
        "mix": [
          "coral",
          18,
          "transparent"
        ]
      },
      "urgentText": {
        "mix": [
          "coral",
          85,
          "bg"
        ]
      },
      "attention": {
        "ref": "yellow"
      },
      "done": {
        "mix": [
          "plum",
          28,
          "bg"
        ]
      },
      "onDone": {
        "ref": "ink"
      },
      "inverse": {
        "ref": "bg"
      },
      "onInverse": {
        "ref": "ink"
      },
      "chipOn": {
        "mix": [
          "plum",
          28,
          "bg"
