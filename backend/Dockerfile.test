# Test image: the runtime image plus the dev toolchain and the test suite.
#
# The container tier exists because the unit tier fakes the Taskwarrior binary at the
# task_runner._run seam. Everything the repository owns is covered there; everything the
# BINARY does — its urgency algorithm, its date parsing, its argument grammar, and the
# per-user isolation that rests on TASKDATA — can only be pinned against the real thing.
#
# Kept as a separate file rather than a stage in backend/Dockerfile on purpose: adding a
# final `test` stage there would make it the default build target, and docker-compose and
# the deploy workflow would silently start shipping an image whose CMD is pytest.
# RULE-TI-002 checks that the base images here stay in step with backend/Dockerfile.

FROM archlinux@sha256:82b1b08faae9d61e3e7e13d562f4d09114d939105b0d59ff34140f3bd418593a AS task-builder
# Must stay byte-identical to backend/Dockerfile's builder stage: the tier that proves
# the binary behaves has to build the same binary. RULE-TI-002 checks the base images agree.
#
# Three things were wrong before, and only the first is obvious:
#
#   archlinux:latest   a floating tag — the base moved whenever Arch rebuilt it
#   pacman -Sy         sync without upgrade: the classic partial-upgrade pattern, and it
#                      installed whatever `task` Arch published that day
#   NoExtract          the Arch image drops /usr/share/doc, where Taskwarrior 3.5.0 keeps
#                      the theme files it refuses to start without (incident 2026-08-25)
#
# The digest pins the base. The Arch Linux Archive pins the *package repository* to a dated
# snapshot, which is what actually pins the binary: a digest alone would not, because pacman
# resolves against live mirrors at build time. `task` is the engine of this product, and its
# version was previously a function of the calendar.
#
# Bumping the snapshot date is a deliberate act. It is the supply-chain equivalent of
# updating a lockfile, and the container tier is what proves the new binary still behaves.
RUN printf 'Server=https://archive.archlinux.org/repos/2026/08/25/$repo/os/$arch\n' \
      > /etc/pacman.d/mirrorlist \
 && sed -i '/^NoExtract/d' /etc/pacman.conf \
 && pacman -Syu --noconfirm task \
 && task --version

FROM python:3.12-slim@sha256:7a8b475003c4fe15a2cd4e55e5cfc2f3560bdc9333d624f24cdd6d4340fd7a17

COPY --from=task-builder /usr/bin/task /usr/local/bin/task
COPY --from=task-builder /usr/share/doc/task/rc/ /usr/share/doc/task/rc/

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgnutls30 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The dev lock covers runtime and tooling together: a gate whose tools float is a gate whose
# verdict changes without anyone changing code.
COPY requirements.txt requirements-dev.txt requirements-dev.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-dev.lock

COPY pyproject.toml taskrc_template.txt ./
COPY app/ ./app/
COPY tests/ ./tests/

RUN mkdir -p /app/data

CMD ["pytest", "tests/container", "--no-header", "--tb=short", "-p", "no:warnings"]
