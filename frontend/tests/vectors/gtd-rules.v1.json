{
  "version": 1,
  "about": "GTD rule vectors shared by the runway web client and the runway Android app. Every case calls one rule with the given arguments and states the exact result. The web runs them in frontend/tests/vectors.test.js against frontend/src/shared/*.js; Android copies this file unchanged (record its SHA-256) and runs every case against its own port. A changed or new rule bumps version. Source of the rules: docs/briefs/0048-gtd-rules-shared-with-android.md.",
  "tz": "Europe/Berlin",
  "today": "2026-10-31",
  "contextPreset": ["@home", "@computer", "@work", "@business"],
  "conventions": {
    "task": "A task as GET /tasks returns it. Omitted fields are empty: tags [], project/due/scheduled/start/end/priority null, urgency 0. Dates are Taskwarrior UTC stamps (20261030T230000Z), except where a rule has just applied a PUT body: then scheduled is the bare day that body sent (2026-10-31), never an invented time. A raw tag may hold several comma-separated parts (\"next,@home\" is ONE tag from an older client); every rule reads the parts.",
    "day": "A calendar day YYYY-MM-DD in tz. Days compare as strings.",
    "args": "The complete argument list, in order. Rules that need today receive it as an argument.",
    "expect": "The exact result, compared as JSON. Where a function's entry below names a projection, the result is projected first.",
    "throws": "Instead of expect: the rule refuses and asks a question. \"context\" means Nächste needs a context (web: NeedsAnswer with what = 'context'). \"legacyTag\" means a legacy comma tag holds a part the API would refuse in tags_add (TAG_RE in backend/app/services/task_service.py, e.g. 'a/b'), so the F2 repair cannot be sent (web: what = 'legacyTag'). Nothing may have been sent.",
    "strings": "The German texts both clients pin, by message key, exactly as frontend/src/shared/messages.de.js holds them. {name} is a placeholder."
  },
  "functions": {
    "listOf": "(task) -> 'inbox' | 'next' | 'waiting' | 'someday' | 'none'. Inbox: no tag parts and no project. Waiting: a part 'waiting'. Someday: a part 'someday'. Next: a part 'next' and neither of the other two (F4: GET /gtd/next also lists next+waiting, the client does not). Checked in that order.",
    "clarifyPayload": "(to, opts) -> PUT body. to: 'next:@ctx' | 'waiting' | 'someday' | 'project:Name'; opts: { followUp: day or '' } for waiting, { ctx } for a project's first action.",
    "listPayload": "(task, list) -> PUT body moving the task to 'next' | 'waiting' | 'someday': add that status tag, remove every raw tag holding one of the other two, add back singly the other parts of a removed comma tag (F2; throws legacyTag when such a part fails the API's TAG_RE), and clear scheduled (\"\") when leaving waiting with a follow-up day.",
    "contextPayload": "(task, ctx) -> PUT body toggling one context. Removing a part of a comma tag removes the raw tag and adds back its other parts (throws legacyTag when such a part fails the API's TAG_RE).",
    "inversePayload": "(before, body) -> the PUT body that undoes body. before = { tags (raw), project, scheduledDay }. Restores tag parts singly, never a comma tag (F2); restores project ('' for none) and scheduled ('' for none) when body changed them.",
    "applyPayload": "(task, body) -> the task after body, as the server applies it. Projection: { tags: sorted raw tags, project, scheduledDay: the day of scheduled or null }.",
    "planPayload": "(task, today) -> { scheduled: today } to plan for today, { scheduled: '' } when already planned (scheduled day <= today), or null for a task in inbox, waiting or someday.",
    "ringOf": "(task, today) -> 'jetzt' | 'bald' | 'spaeter'. Jetzt: due day <= today, running (start), priority H, or planned for today. Bald: due day <= today + 7, or priority M. Spaeter: the rest. Urgency never decides.",
    "plannedToday": "(task, today) -> boolean: due day <= today, or scheduled day <= today unless the task is waiting (there scheduled is the follow-up day), or running.",
    "nextSections": "({ tasks, today }, ctx) -> sections of Nächste. ctx: null (all), '@x' (that context or no context), or '-' (only without context). faellig: open non-inbox tasks of any list with due day <= today that pass ctx, oldest due first. faelligAndere: with a ctx, the due tasks that do not pass it. dueMerged: faellig empty and faelligAndere not (show them under the one Fällig heading with the note 'andere Kontexte'). jetzt/bald/spaeter: listOf = next, passing ctx, not due; order: running first, then priority H, then urgency high to low. Projection: each section as a list of uuids.",
    "dayProgress": "(open, doneToday, today) -> { done, planned, extra, total, level }. planned: open tasks not in inbox/waiting/someday with plannedToday. done: doneToday tasks with plannedAtHold = true, or not in inbox/waiting/someday with plannedToday: the same test as planned (correction to 06, which skipped the list test for done tasks, so a ticked inbox/waiting/someday task due today grew the denominator). F6: done drops start, so the tick records that test as plannedAtHold. extra = doneToday - done; total = done + planned; level = done / total, 0 when total is 0.",
    "lensCaption": "(progress, opts) -> the caption. opts.short drops 'heute'. Extra is always ' · N zusätzlich', never '+N'.",
    "orderContexts": "(present, preset) -> the present contexts: preset entries that are present, in preset order, then the rest in German collation; each once.",
    "contextCounts": "(tasks) -> { all, none, byContext }. Only listOf = next counts. all: those; none: those without a context; byContext: per context, the tasks carrying it (strict).",
    "eyebrowCount": "(selected, counts) -> the parts after the list name, shown with ' · ' between them: the context's name ('alle Kontexte' for null, 'ohne Kontext' for '-'), its chip count, and '+N ohne Kontext' when a context is selected and N > 0 tasks have none.",
    "dayOf": "(stamp) -> the day of a UTC stamp in tz, or null. A bare day is returned as is.",
    "followUpDay": "(answer, today) -> the follow-up day. tomorrow: the next working day (Monday after a Friday or weekend); friday: the next Friday after today, a week later when it equals tomorrow's answer; week: the Monday after tomorrow's answer; none: ''.",
    "projectNameError": "(name, existing) -> '' or a message key: proj.err.empty, .long (over 100 characters), .chars (control characters or ( ) \" ' \\ : / ? # %), .edge (starts with + - or whitespace, ends with whitespace; whitespace is Python's str.isspace set, as PROJECT_RE reads it: U+0085 is, U+FEFF is not), .reserved ('overview', 'plans', exact), .exists (case-insensitive among existing)."
  },
  "cases": [
    { "id": "listOf/inbox", "fn": "listOf", "args": [{ "uuid": "a" }], "expect": "inbox" },
    { "id": "listOf/project-without-tags", "fn": "listOf", "args": [{ "uuid": "a", "project": "Garten" }], "expect": "none" },
    { "id": "listOf/context-alone-is-not-next", "fn": "listOf", "args": [{ "uuid": "a", "tags": ["@computer"] }], "expect": "none" },
    { "id": "listOf/next", "fn": "listOf", "args": [{ "uuid": "a", "tags": ["next", "@computer"] }], "expect": "next" },
    { "id": "listOf/f4-next-and-waiting", "fn": "listOf", "args": [{ "uuid": "a", "tags": ["next", "waiting", "@anrufe"] }], "expect": "waiting" },
    { "id": "listOf/f4-next-and-someday", "fn": "listOf", "args": [{ "uuid": "a", "tags": ["someday", "next"] }], "expect": "someday" },
    { "id": "listOf/legacy-comma-next", "fn": "listOf", "args": [{ "uuid": "a", "tags": ["next,@home"] }], "expect": "next" },
    { "id": "listOf/legacy-comma-waiting", "fn": "listOf", "args": [{ "uuid": "a", "tags": ["@home, waiting"] }], "expect": "waiting" },
    { "id": "listOf/plain-tag", "fn": "listOf", "args": [{ "uuid": "a", "tags": ["ar"] }], "expect": "none" },

    { "id": "clarifyPayload/next-with-context", "fn": "clarifyPayload", "args": ["next:@anrufe", {}], "expect": { "tags_add": ["next", "@anrufe"] } },
    { "id": "clarifyPayload/next-without-context", "fn": "clarifyPayload", "args": ["next", {}], "throws": "context" },
    { "id": "clarifyPayload/waiting-with-follow-up", "fn": "clarifyPayload", "args": ["waiting", { "followUp": "2026-11-06" }], "expect": { "tags_add": ["waiting"], "scheduled": "2026-11-06" } },
    { "id": "clarifyPayload/waiting-without-date", "fn": "clarifyPayload", "args": ["waiting", { "followUp": "" }], "expect": { "tags_add": ["waiting"] } },
    { "id": "clarifyPayload/someday", "fn": "clarifyPayload", "args": ["someday", {}], "expect": { "tags_add": ["someday"] } },
    { "id": "clarifyPayload/project-with-context", "fn": "clarifyPayload", "args": ["project:Garten", { "ctx": "@zuhause" }], "expect": { "project": "Garten", "tags_add": ["next", "@zuhause"] } },
    { "id": "clarifyPayload/project-without-context", "fn": "clarifyPayload", "args": ["project:Garten", {}], "throws": "context" },

    { "id": "listPayload/waiting-to-next-keeps-contexts", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["waiting", "@anrufe", "ar"] }, "next"], "expect": { "tags_add": ["next"], "tags_remove": ["waiting"] } },
    { "id": "listPayload/waiting-to-next-clears-follow-up", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["waiting", "@anrufe"], "scheduled": "20261030T230000Z" }, "next"], "expect": { "tags_add": ["next"], "tags_remove": ["waiting"], "scheduled": "" } },
    { "id": "listPayload/next-to-someday-keeps-a-plan", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "20261030T230000Z" }, "someday"], "expect": { "tags_add": ["someday"], "tags_remove": ["next"] } },
    { "id": "listPayload/next-to-waiting", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["next", "@a"] }, "waiting"], "expect": { "tags_add": ["waiting"], "tags_remove": ["next"] } },
    { "id": "listPayload/someday-to-next-without-context", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["someday"] }, "next"], "throws": "context" },
    { "id": "listPayload/f4-dual-tagged-to-next", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["next", "waiting", "@anrufe"] }, "next"], "expect": { "tags_add": ["next"], "tags_remove": ["waiting"] } },
    { "id": "listPayload/legacy-comma-tag-keeps-its-context", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["next,@home"] }, "waiting"], "expect": { "tags_add": ["waiting", "@home"], "tags_remove": ["next,@home"] } },
    { "id": "listPayload/legacy-part-held-elsewhere-is-not-added", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["@home", "next,@home"] }, "someday"], "expect": { "tags_add": ["someday"], "tags_remove": ["next,@home"] } },
    { "id": "listPayload/legacy-two-status-parts", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["next,waiting,@x"] }, "someday"], "expect": { "tags_add": ["someday", "@x"], "tags_remove": ["next,waiting,@x"] } },
    { "id": "listPayload/legacy-part-the-api-refuses", "fn": "listPayload", "args": [{ "uuid": "a", "tags": ["next,a/b", "@x"] }, "waiting"], "throws": "legacyTag" },

    { "id": "contextPayload/add", "fn": "contextPayload", "args": [{ "uuid": "a", "tags": ["next"] }, "@anrufe"], "expect": { "tags_add": ["@anrufe"] } },
    { "id": "contextPayload/remove", "fn": "contextPayload", "args": [{ "uuid": "a", "tags": ["next", "@computer"] }, "@computer"], "expect": { "tags_remove": ["@computer"] } },
    { "id": "contextPayload/legacy-repairs-the-tag", "fn": "contextPayload", "args": [{ "uuid": "a", "tags": ["next", "@unterwegs,@buero"] }, "@buero"], "expect": { "tags_remove": ["@unterwegs,@buero"], "tags_add": ["@unterwegs"] } },
    { "id": "contextPayload/legacy-keeps-a-status-part", "fn": "contextPayload", "args": [{ "uuid": "a", "tags": ["next,@home"] }, "@home"], "expect": { "tags_remove": ["next,@home"], "tags_add": ["next"] } },
    { "id": "contextPayload/legacy-part-the-api-refuses", "fn": "contextPayload", "args": [{ "uuid": "a", "tags": ["next", "@home,a/b"] }, "@home"], "throws": "legacyTag" },

    { "id": "inversePayload/clarify-waiting-with-follow-up", "fn": "inversePayload", "args": [{ "tags": [], "project": null, "scheduledDay": null }, { "tags_add": ["waiting"], "scheduled": "2026-11-06" }], "expect": { "tags_remove": ["waiting"], "scheduled": "" } },
    { "id": "inversePayload/waiting-to-next-restores-the-follow-up", "fn": "inversePayload", "args": [{ "tags": ["waiting", "@anrufe"], "project": null, "scheduledDay": "2026-10-31" }, { "tags_add": ["next"], "tags_remove": ["waiting"], "scheduled": "" }], "expect": { "tags_remove": ["next"], "tags_add": ["waiting"], "scheduled": "2026-10-31" } },
    { "id": "inversePayload/clarify-project", "fn": "inversePayload", "args": [{ "tags": [], "project": null, "scheduledDay": null }, { "project": "Garten", "tags_add": ["next", "@zuhause"] }], "expect": { "tags_remove": ["next", "@zuhause"], "project": "" } },
    { "id": "inversePayload/legacy-list-move-restores-parts", "fn": "inversePayload", "args": [{ "tags": ["next,@home"], "project": null, "scheduledDay": null }, { "tags_add": ["waiting", "@home"], "tags_remove": ["next,@home"] }], "expect": { "tags_remove": ["waiting"], "tags_add": ["next"] } },
    { "id": "inversePayload/legacy-context-restores-parts", "fn": "inversePayload", "args": [{ "tags": ["next", "@unterwegs,@buero"], "project": null, "scheduledDay": null }, { "tags_remove": ["@unterwegs,@buero"], "tags_add": ["@unterwegs"] }], "expect": { "tags_add": ["@buero"] } },
    { "id": "inversePayload/plan-for-today", "fn": "inversePayload", "args": [{ "tags": ["next", "@a"], "project": null, "scheduledDay": null }, { "scheduled": "2026-10-31" }], "expect": { "scheduled": "" } },
    { "id": "inversePayload/a-tag-already-there-stays", "fn": "inversePayload", "args": [{ "tags": ["next", "@a"], "project": null, "scheduledDay": null }, { "tags_add": ["@a"] }], "expect": {} },

    { "id": "applyPayload/clarify-next", "fn": "applyPayload", "args": [{ "uuid": "a" }, { "tags_add": ["next", "@anrufe"] }], "expect": { "tags": ["@anrufe", "next"], "project": null, "scheduledDay": null } },
    { "id": "applyPayload/waiting-with-follow-up-holds-the-day", "fn": "applyPayload", "args": [{ "uuid": "a" }, { "tags_add": ["waiting"], "scheduled": "2026-11-06" }], "expect": { "tags": ["waiting"], "project": null, "scheduledDay": "2026-11-06" } },
    { "id": "applyPayload/clearing-scheduled", "fn": "applyPayload", "args": [{ "uuid": "a", "tags": ["waiting", "@anrufe"], "scheduled": "20261030T230000Z" }, { "tags_add": ["next"], "tags_remove": ["waiting"], "scheduled": "" }], "expect": { "tags": ["@anrufe", "next"], "project": null, "scheduledDay": null } },
    { "id": "applyPayload/legacy-move", "fn": "applyPayload", "args": [{ "uuid": "a", "tags": ["next,@home"] }, { "tags_add": ["waiting", "@home"], "tags_remove": ["next,@home"] }], "expect": { "tags": ["@home", "waiting"], "project": null, "scheduledDay": null } },
    { "id": "applyPayload/legacy-undo-repairs", "fn": "applyPayload", "args": [{ "uuid": "a", "tags": ["waiting", "@home"] }, { "tags_remove": ["waiting"], "tags_add": ["next"] }], "expect": { "tags": ["@home", "next"], "project": null, "scheduledDay": null } },
    { "id": "applyPayload/project-and-clear", "fn": "applyPayload", "args": [{ "uuid": "a", "project": "Garten", "tags": ["next", "@zuhause"] }, { "project": "", "tags_remove": ["next", "@zuhause"] }], "expect": { "tags": [], "project": null, "scheduledDay": null } },
    { "id": "applyPayload/adding-twice-keeps-one", "fn": "applyPayload", "args": [{ "uuid": "a", "tags": ["next", "@a"] }, { "tags_add": ["@a"], "tags_remove": ["someday"] }], "expect": { "tags": ["@a", "next"], "project": null, "scheduledDay": null } },

    { "id": "planPayload/plan-a-next-action", "fn": "planPayload", "args": [{ "uuid": "a", "tags": ["next", "@a"] }, "2026-10-31"], "expect": { "scheduled": "2026-10-31" } },
    { "id": "planPayload/unplan-today", "fn": "planPayload", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "20261030T230000Z" }, "2026-10-31"], "expect": { "scheduled": "" } },
    { "id": "planPayload/unplan-an-older-plan", "fn": "planPayload", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "20261028T230000Z" }, "2026-10-31"], "expect": { "scheduled": "" } },
    { "id": "planPayload/a-future-plan-moves-to-today", "fn": "planPayload", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "20261102T230000Z" }, "2026-10-31"], "expect": { "scheduled": "2026-10-31" } },
    { "id": "planPayload/without-a-list", "fn": "planPayload", "args": [{ "uuid": "a", "tags": ["@a"] }, "2026-10-31"], "expect": { "scheduled": "2026-10-31" } },
    { "id": "planPayload/refused-in-waiting", "fn": "planPayload", "args": [{ "uuid": "a", "tags": ["waiting"], "scheduled": "20261030T230000Z" }, "2026-10-31"], "expect": null },
    { "id": "planPayload/refused-in-inbox", "fn": "planPayload", "args": [{ "uuid": "a" }, "2026-10-31"], "expect": null },
    { "id": "planPayload/refused-in-someday", "fn": "planPayload", "args": [{ "uuid": "a", "tags": ["someday"] }, "2026-10-31"], "expect": null },

    { "id": "ringOf/overdue", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "due": "20261030T170000Z" }, "2026-10-31"], "expect": "jetzt" },
    { "id": "ringOf/due-today-last-second", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "due": "20261031T225959Z" }, "2026-10-31"], "expect": "jetzt" },
    { "id": "ringOf/due-tomorrow-first-second", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "due": "20261031T230000Z" }, "2026-10-31"], "expect": "bald" },
    { "id": "ringOf/priority-h", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "priority": "H" }, "2026-10-31"], "expect": "jetzt" },
    { "id": "ringOf/running", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "start": "20261031T083000Z" }, "2026-10-31"], "expect": "jetzt" },
    { "id": "ringOf/planned-for-today", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "20261030T230000Z" }, "2026-10-31"], "expect": "jetzt" },
    { "id": "ringOf/due-within-seven-days", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "due": "20261107T170000Z" }, "2026-10-31"], "expect": "bald" },
    { "id": "ringOf/due-in-eight-days", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "due": "20261108T170000Z" }, "2026-10-31"], "expect": "spaeter" },
    { "id": "ringOf/priority-m", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "priority": "M" }, "2026-10-31"], "expect": "bald" },
    { "id": "ringOf/urgency-never-decides", "fn": "ringOf", "args": [{ "uuid": "a", "tags": ["next", "@a"], "urgency": 99 }, "2026-10-31"], "expect": "spaeter" },

    { "id": "plannedToday/a-follow-up-is-not-a-plan", "fn": "plannedToday", "args": [{ "uuid": "a", "tags": ["waiting", "@anrufe"], "scheduled": "20261030T230000Z" }, "2026-10-31"], "expect": false },
    { "id": "plannedToday/scheduled-today", "fn": "plannedToday", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "20261030T230000Z" }, "2026-10-31"], "expect": true },
    { "id": "plannedToday/scheduled-tomorrow", "fn": "plannedToday", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "20261031T230000Z" }, "2026-10-31"], "expect": false },
    { "id": "plannedToday/optimistic-bare-day", "fn": "plannedToday", "args": [{ "uuid": "a", "tags": ["next", "@a"], "scheduled": "2026-10-31" }, "2026-10-31"], "expect": true },
    { "id": "plannedToday/running", "fn": "plannedToday", "args": [{ "uuid": "a", "tags": ["next", "@a"], "start": "20261031T083000Z" }, "2026-10-31"], "expect": true },
    { "id": "plannedToday/nothing-set", "fn": "plannedToday", "args": [{ "uuid": "a", "tags": ["next", "@a"], "priority": "H" }, "2026-10-31"], "expect": false },

    { "id": "nextSections/all-contexts", "fn": "nextSections", "args": [{ "today": "2026-10-31", "tasks": [
        { "uuid": "d1", "tags": ["next", "@anrufe"], "due": "20261029T170000Z", "urgency": 12 },
        { "uuid": "d2", "tags": ["next", "@computer"], "due": "20261031T100000Z", "urgency": 11 },
        { "uuid": "d3", "tags": ["waiting", "@anrufe"], "due": "20261030T170000Z", "urgency": 2 },
        { "uuid": "i1", "due": "20261031T100000Z", "urgency": 1 },
        { "uuid": "j1", "tags": ["next", "@computer"], "priority": "H", "urgency": 5 },
        { "uuid": "j2", "tags": ["next", "@anrufe"], "start": "20261031T083000Z", "urgency": 3 },
        { "uuid": "j3", "tags": ["next", "@computer"], "scheduled": "20261030T230000Z", "urgency": 9 },
        { "uuid": "b1", "tags": ["next", "@computer"], "due": "20261105T170000Z", "urgency": 7 },
        { "uuid": "b2", "tags": ["next"], "priority": "M", "urgency": 2 },
        { "uuid": "s1", "tags": ["next", "@zuhause"], "urgency": 4 },
        { "uuid": "s2", "tags": ["next", "waiting", "@anrufe"], "urgency": 6 },
        { "uuid": "s3", "tags": ["@anrufe"], "urgency": 8 }
      ] }, null], "expect": { "faellig": ["d1", "d3", "d2"], "faelligAndere": [], "dueMerged": false, "jetzt": ["j2", "j1", "j3"], "bald": ["b1", "b2"], "spaeter": ["s1"] } },
    { "id": "nextSections/context-with-due-elsewhere", "fn": "nextSections", "args": [{ "today": "2026-10-31", "tasks": [
        { "uuid": "d1", "tags": ["next", "@anrufe"], "due": "20261029T170000Z", "urgency": 12 },
        { "uuid": "d2", "tags": ["next", "@computer"], "due": "20261031T100000Z", "urgency": 11 },
        { "uuid": "d3", "tags": ["waiting", "@anrufe"], "due": "20261030T170000Z", "urgency": 2 },
        { "uuid": "j1", "tags": ["next", "@computer"], "priority": "H", "urgency": 5 },
        { "uuid": "j2", "tags": ["next", "@anrufe"], "start": "20261031T083000Z", "urgency": 3 },
        { "uuid": "j3", "tags": ["next", "@computer"], "scheduled": "20261030T230000Z", "urgency": 9 },
        { "uuid": "b1", "tags": ["next", "@computer"], "due": "20261105T170000Z", "urgency": 7 },
        { "uuid": "b2", "tags": ["next"], "priority": "M", "urgency": 2 },
        { "uuid": "s1", "tags": ["next", "@zuhause"], "urgency": 4 }
      ] }, "@anrufe"], "expect": { "faellig": ["d1", "d3"], "faelligAndere": ["d2"], "dueMerged": false, "jetzt": ["j2"], "bald": ["b2"], "spaeter": [] } },
    { "id": "nextSections/legacy-comma-context", "fn": "nextSections", "args": [{ "today": "2026-10-31", "tasks": [
        { "uuid": "d2", "tags": ["next", "@computer"], "due": "20261031T100000Z", "urgency": 11 },
